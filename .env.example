# Public Vite client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=
VITE_WHATSAPP_NUMBER=
VITE_API_MODE=supabase
VITE_SUPABASE_FUNCTIONS_URL=
# Absolute API origin for the Android/iOS app (no trailing slash). Leave empty on web.
VITE_API_BASE_URL=

# Razorpay payment gateway (server-only secret, public key_id also exposed via VITE_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# Server-only configuration for local Express API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:5173

# Email notifications (enquiry/booking alerts to admin)
# Use mail.myvedicastrology.in (NOT ns1.sslsecure.co.in which is a nameserver)
SMTP_HOST=mail.myvedicastrology.in
SMTP_PORT=465
SMTP_USER=info@myvedicastrology.in
SMTP_PASS=
SMTP_FROM=info@myvedicastrology.in
ADMIN_EMAIL=

# Admin authentication — REQUIRED, no defaults (all must be set in production)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL direct connection (used by Express server for enquiries/media)
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# Set PG_SSL=false only if your DB host does not support SSL
PG_SSL=