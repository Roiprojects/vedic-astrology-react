    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "dev:vite": "vite",
    "dev:api": "tsx server/index.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.3.4",
    "@supabase/ssr": "^0.12.0",
